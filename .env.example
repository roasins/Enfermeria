# --- App web (variables de BUILD; también se configuran en Cloudflare) ---
# Solo el proyecto Supabase de enfermería.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (publishable o anon). Nunca la service role.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# --- Solo para el script `npm run seed:admin` (se corre una vez, en tu computador) ---
# No van en Cloudflare ni en el código.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# Opcionales: nombre a mostrar y contraseña si la cuenta todavía no existe.
ADMIN_NOMBRE=
ADMIN_PASSWORD=
